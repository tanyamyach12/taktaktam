<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced Interactive Website</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f0f0f0;
            padding: 50px;
            transition: background-color 0.5s ease;
        }
        h1 {
            font-size: 40px;
            color: #333;
            animation: fadeIn 2s ease-in-out;
        }
        p {
            font-size: 18px;
            color: #666;
        }
        .clock {
            font-size: 24px;
            margin: 20px 0;
            padding: 10px;
            background: #fff;
            display: inline-block;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        button {
            padding: 10px 20px;
            font-size: 16px;
            border: none;
            background-color: #007BFF;
            color: white;
            cursor: pointer;
            transition: background 0.3s;
            border-radius: 5px;
            margin: 10px;
        }
        button:hover {
            background-color: #0056b3;
        }
        .modal {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
            border-radius: 5px;
        }
        .modal button {
            margin-top: 10px;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <h1>Welcome to My Advanced Website</h1>
    <p>Click the button to change the background color or check the time.</p>

    <div class="clock" id="clock">Loading...</div>

    <button onclick="changeColor()">Change Background</button>
    <button onclick="openModal()">Open Modal</button>

    <div class="modal" id="modal">
        <h2>Modal Window</h2>
        <p>This is an interactive modal.</p>
        <button onclick="closeModal()">Close</button>
    </div>

    <script>
        function changeColor() {
            const colors = ["#ffadad", "#ffd6a5", "#fdffb6", "#caffbf", "#9bf6ff", "#a0c4ff", "#bdb2ff"];
            document.body.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
        }

        function updateClock() {
            const now = new Date();
            document.getElementById('clock').innerText = now.toLocaleTimeString();
        }
        setInterval(updateClock, 1000);
        updateClock();

        function openModal() {
            document.getElementById('modal').style.display = "block";
        }

        function closeModal() {
            document.getElementById('modal').style.display = "none";
        }
    </script>
</body>
</html>
